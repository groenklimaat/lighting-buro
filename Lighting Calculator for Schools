  });

  $('appTitle').innerHTML = t.app_title + ' <span class="school-badge">School</span>';
  $('appSubtitle').textContent = t.subtitle;
  $('hProjectLabel').textContent = t.project + ':';
  $('hAddressLabel').textContent = t.address + ':';
  $('hBuildingLabel').textContent = t.building_type + ':';
  $('hDimmableLabel').textContent = t.dimmable + ':';

  $('secGeneralInfo').textContent = t.general_info;
  $('secDimmable').textContent = t.dimmable_title;
  $('secContact').textContent = t.contact;

  $('lblProjectName').textContent = t.project_name;
  $('lblAddress').textContent = t.address_label;
  $('lblCountry').textContent = t.country;
  $('lblContactPerson').textContent = t.contact_person;
  $('lblEmail').textContent = t.email;

  $('dimYesLabel').textContent = t.dimmable_yes;
  $('dimNoLabel').textContent = t.dimmable_no;
  $('dimSmartLabel').textContent = t.dimmable_smart;

  $('epbDisclaimer').textContent = '🌿 ' + t.epb_disclaimer;
  $('mainTitle').textContent = t.annual_consumption_title;
  $('presetsLabel').textContent = t.quick_presets + ':';

  document.querySelectorAll('.preset-btn').forEach((btn, i) => {
    btn.textContent = t[PRESETS[i].key];
  });

  $('priceTitle').textContent = '💶 ' + t.energy_price;
  $('lblNumLuminaires').textContent = t.num_luminaires;
  $('lblPowerPerLuminaire').textContent = t.power_per_luminaire;
  $('lblHoursPerDay').textContent = t.hours_per_day;
  $('lblDaysPerWeek').textContent = t.days_per_week;

  $('weeksLabel').textContent = '📆 ' + t.weeks_per_year + ': 52';
  $('co2FactorLabel').textContent = '📊 CO₂ ' + t.factor + ': 0.5 kg/kWh';

  $('resTotalPowerLabel').textContent = t.total_power;
  $('resConsumptionLabel').textContent = t.annual_consumption;
  $('resCostLabel').textContent = t.annual_cost;
  $('resCo2Label').textContent = t.co2_emission;

  $('btnUpdate').textContent = '🔄 ' + t.update;
  $('btnPdf').textContent = '📄 ' + t.pdf_report;
  $('btnPreview').textContent = '👁 ' + t.preview;
  $('btnReset').textContent = '↺ ' + t.reset;

  $('footnote1').textContent = '📏 ' + t.energy_label_explanation;
  $('footnote2').textContent = '📄 ' + t.pdf_info;

  updateRoomLabels();
  updateHeaderInfo();
  onSliderChange();

  $('modalTitle').textContent = t.pdf_preview;
}

function updateHeaderInfo() {
  const t = TRANSLATIONS[currentLang];

  const projectVal = $('projectName').value.trim();
  $('hProject').textContent = projectVal || '—';
  $('hProject').className = 'value' + (projectVal ? '' : ' empty');

  const addressVal = $('addressName').value.trim();
  $('hAddress').textContent = addressVal || '—';
  $('hAddress').className = 'value' + (addressVal ? '' : ' empty');

  const room = SCHOOL_ROOMS.find(r => r.id === activeRoom);
  if (room) {
    const roomName = room.name[currentLang] || room.name.en;
    $('hBuilding').textContent = roomName.replace(/^[^\s]+\s/, '');
  }

  const dim = document.querySelector('input[name="dimmable"]:checked').value;
  const dimMap = { yes: 'dimmable_yes', no: 'dimmable_no', smart: 'dimmable_smart' };
  const dimText = t[dimMap[dim]];
  $('hDimmable').textContent = dimText.replace(/^[^\s]+\s/, '');

  if (dim === 'yes') {
    $('dimmableIcon').textContent = '🔆 ' + t.dimmable;
  } else if (dim === 'smart') {
    $('dimmableIcon').textContent = '📶 ' + t.smart;
  } else {
    $('dimmableIcon').textContent = '⭕ ' + t.dimmable_no;
  }
}

// ============================================================================
// SLIDER / PRESET
// ============================================================================
function onSliderChange() {
  const t = TRANSLATIONS[currentLang];

  const sliders = [
    { id: 'numLuminaires', valId: 'valNumLuminaires', dispId: 'dispNumLuminaires', unit: 'pieces' },
    { id: 'powerPerLuminaire', valId: 'valPowerPerLuminaire', dispId: 'dispPowerPerLuminaire', unit: 'W' },
    { id: 'hoursPerDay', valId: 'valHoursPerDay', dispId: 'dispHoursPerDay', unit: 'hours' },
    { id: 'daysPerWeek', valId: 'valDaysPerWeek', dispId: 'dispDaysPerWeek', unit: 'days' }
  ];

  sliders.forEach(s => {
    const val = parseInt($(s.id).value);
    $(s.valId).textContent = val;
    const unitText = (s.unit === 'W') ? 'W' : (t[s.unit] || s.unit);
    $(s.dispId).textContent = val + ' ' + unitText;
  });

  calculate();
}

function setLumenWatt(lmw, kelvin, index) {
  const defaultFlux = 3600;
  let newPower = Math.round(defaultFlux / lmw);
  newPower = Math.max(5, Math.min(200, newPower));

  $('powerPerLuminaire').value = newPower;
  currentLmw = lmw;
  currentKelvin = kelvin;

  activePreset = index;
  document.querySelectorAll('.preset-btn').forEach((btn, i) => {
    btn.classList.toggle('active', i === index);
  });

  onSliderChange();
}

function onCountryChange() {
  const key = $('countrySelect').value;
  const [price, currency] = COUNTRIES[key];
  $('energyPrice').value = price;
  $('currencySelect').value = currency;
  calculate();
}

// ============================================================================
// CALCULATIONS
// ============================================================================
function calculate() {
  const num = parseInt($('numLuminaires').value) || 0;
  const power = parseInt($('powerPerLuminaire').value) || 0;
  const hours = parseInt($('hoursPerDay').value) || 0;
  const days = parseInt($('daysPerWeek').value) || 0;
  const weeks = 52;

  const totalPowerKw = (num * power) / 1000;
  const yearlyHours = hours * days * weeks;
  const kwh = totalPowerKw * yearlyHours;

  let price = parseFloat($('energyPrice').value) || 0.32;
  const cost = kwh * price;
  const co2 = kwh * 0.5;

  const fmt = (v) => {
    let s = v < 1000 ? v.toFixed(2) : Math.round(v).toLocaleString('en-US');
    if (['nl', 'de', 'fr', 'es', 'pt', 'it', 'no', 'sv'].includes(currentLang)) {
      s = s.replace(/,/g, 'X').replace(/\./g, ',').replace(/X/g, '.');
    }
    return s;
  };

  $('resTotalPower').textContent = fmt(totalPowerKw);
  $('resConsumption').textContent = fmt(Math.round(kwh));
  $('resCost').textContent = fmt(Math.round(cost));
  $('resCo2').textContent = fmt(Math.round(co2));

  const currency = $('currencySelect').value;
  $('resCostUnit').textContent = currency;

  const defaultFlux = 3600;
  const lmw = power > 0 ? Math.round(defaultFlux / power) : 0;

  $('lmwDisplay').textContent = lmw + ' lm/W';
  $('kelvinDisplay').textContent = currentKelvin + ' K';

  for (const [threshold, label, color] of ENERGY_LABELS) {
    if (lmw >= threshold) {
      $('labelPill').textContent = label;
      $('labelPill').style.background = color;
      break;
    }
  }
}

// ============================================================================
// RESET
// ============================================================================
function resetDefault() {
  $('projectName').value = 'Janssens';
  $('addressName').value = '';
  $('contactPerson').value = '';
  $('contactEmail').value = '';
  $('countrySelect').value = 'Belgium';
  document.querySelector('input[name="dimmable"][value="yes"]').checked = true;
  $('energyPrice').value = 0.32;
  $('currencySelect').value = '€';

  applyRoom('classroom');
  updateHeaderInfo();
  calculate();
}

// ============================================================================
// REPORT DATA
// ============================================================================
function getReportData() {
  const t = TRANSLATIONS[currentLang];
  const room = SCHOOL_ROOMS.find(r => r.id === activeRoom);
  const roomText = room ? (room.name[currentLang] || room.name.en) : '—';

  const country = $('countrySelect').value;
  const dim = document.querySelector('input[name="dimmable"]:checked').value;
  const dimMap = { yes: 'dimmable_yes', no: 'dimmable_no', smart: 'dimmable_smart' };
  const dimText = t[dimMap[dim]];

  return {
    appTitle: t.app_title,
    generatedOn: new Date().toLocaleDateString('en-GB').replace(/\//g, '-'),
    project: $('projectName').value || '—',
    address: $('addressName').value || '—',
    contact: ($('contactPerson').value || '') + ($('contactEmail').value ? ' (' + $('contactEmail').value + ')' : ''),
    country: country,
    buildingType: roomText,
    dimmable: dimText,
    numLuminaires: $('numLuminaires').value,
    power: $('powerPerLuminaire').value,
    lmw: $('lmwDisplay').textContent,
    kelvin: $('kelvinDisplay').textContent,
    energyLabel: $('labelPill').textContent,
    hours: $('hoursPerDay').value,
    days: $('daysPerWeek').value,
    totalPower: $('resTotalPower').textContent,
    consumption: $('resConsumption').textContent,
    cost: $('resCost').textContent,
    currency: $('currencySelect').value,
    co2: $('resCo2').textContent,
    price: $('energyPrice').value,
    t: t
  };
}

// ============================================================================
// PREVIEW MODAL
// ============================================================================
function previewPdf() {
  const data = getReportData();
  const t = data.t;

  $('modalDate').textContent = t.generated_on + ': ' + data.generatedOn;

  let html = '';
  const addSection = (title) => { html += '<div class="modal-section-title">' + title + '</div>'; };
  const addRow = (label, value) => {
    html += '<div class="modal-row"><span class="label">' + label + '</span><span class="value">' + value + '</span></div>';
