<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LightingBuro School Edition | Lighting Calculator for Schools</title>

<!-- PWA Meta Tags -->
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#0B2B40">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="School Lighting">
<meta name="description" content="Free lighting calculator for schools. Calculate energy consumption, costs and CO₂ emissions of school lighting installations.">
<link rel="icon" type="image/png" href="icon-512.png">

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --primary: #0B2B40;
    --primary-light: #1F4B66;
    --accent: #FFD966;
    --accent-hover: #FFE89A;
    --success: #1F7B4D;
    --success-hover: #2A965F;
    --school: #4A90E2;
    --bg: #F1F5F9;
    --card-bg: #FFFFFF;
    --panel-bg: #F8FAFC;
    --border: #DEE7EF;
    --text: #0B2B40;
    --text-light: #5B7E9C;
    --slider-bg: #D0E0ED;
    --slider-fg: #2C7DA0;
    --result-bg: #F2F9FF;
    --result-border: #BFDDF2;
  }

  body {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding: 20px;
  }

  .app-container {
    max-width: 1420px;
    margin: 0 auto;
    background: var(--card-bg);
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(11, 43, 64, 0.12);
    overflow: hidden;
    border: 1px solid #CBD5E1;
  }

  /* HEADER */
  .header {
    background: var(--primary);
    padding: 18px 30px 14px;
    color: white;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-brand .logo-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px;
  }

  .header-brand h1 {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
  }

  .header-brand p {
    font-size: 12px;
    color: #CBD5E1;
    margin-top: 2px;
  }

  .school-badge {
    display: inline-block;
    background: var(--school);
    color: white;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    margin-left: 8px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .lang-buttons {
    display: flex;
    gap: 3px;
    flex-wrap: wrap;
  }

  .lang-btn {
    background: var(--primary-light);
    color: #A0C6E0;
    border: none;
    padding: 6px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 34px;
    font-family: inherit;
  }

  .lang-btn:hover { background: #2A5A7A; color: white; }
  .lang-btn.active { background: var(--accent); color: var(--primary); }

  .header-info {
    display: flex;
    gap: 28px;
    margin-top: 14px;
    flex-wrap: wrap;
    font-size: 13px;
  }

  .header-info-item {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #CBD5E1;
  }

  .header-info-item .value { color: white; font-weight: 600; }
  .header-info-item .value.empty { color: #7A8FA3; font-style: italic; }

  /* CONTENT LAYOUT */
  .content { display: flex; min-height: 700px; }

  .left-panel {
    width: 440px;
    min-width: 440px;
    background: var(--panel-bg);
    padding: 25px;
    overflow-y: auto;
    max-height: 80vh;
    border-right: 1px solid var(--border);
  }

  .right-panel {
    flex: 1;
    padding: 30px;
    overflow-y: auto;
    max-height: 80vh;
    background: var(--card-bg);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #2C5F7B;
    margin-bottom: 10px;
    margin-top: 20px;
  }

  .section-title:first-child { margin-top: 0; }

  .info-block {
    background: white;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 15px 18px;
    margin-bottom: 5px;
  }

  .field-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .field-row:last-child { margin-bottom: 0; }

  .field-row label {
    font-size: 13px;
    font-weight: 600;
    color: #1E3A5F;
    width: 130px;
    min-width: 130px;
  }

  .field-row input,
  .field-row select {
    flex: 1;
    padding: 8px 10px;
    border: 2px solid #CDDCEC;
    border-radius: 6px;
    font-size: 13px;
    font-family: inherit;
    color: var(--text);
    background: white;
    transition: border-color 0.2s;
    outline: none;
    min-width: 0;
  }

  .field-row input:focus,
  .field-row select:focus { border-color: var(--slider-fg); }

  .field-row input::placeholder { color: #A9BCCD; font-style: italic; }

  /* SCHOOL ROOMS SECTION */
  .rooms-title {
    background: linear-gradient(135deg, #E8F2FC 0%, #D6E8F7 100%);
    border: 2px solid #A9CCE8;
    border-radius: 10px;
    padding: 12px 15px;
    margin-top: 20px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .rooms-title h3 {
    font-size: 14px;
    font-weight: 700;
    color: #1A4A6B;
    flex: 1;
  }

  .rooms-title .free-badge {
    background: var(--success);
    color: white;
    font-size: 10px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .room-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    background: white;
    border: 2px solid #CDDCEC;
    border-radius: 8px;
    padding: 10px 14px;
    margin-bottom: 8px;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: all 0.2s;
    font-size: 13px;
    color: var(--text);
  }

  .room-btn:hover {
    border-color: var(--school);
    background: #F0F8FF;
  }

  .room-btn.active {
    border-color: var(--school);
    background: #E8F2FC;
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
  }

  .room-btn .room-icon {
    font-size: 18px;
    width: 24px;
    text-align: center;
  }

  .room-btn .room-info {
    flex: 1;
  }

  .room-btn .room-name {
    font-weight: 700;
    color: #1E3A5F;
    font-size: 13px;
  }

  .room-btn .room-specs {
    font-size: 11px;
    color: var(--text-light);
    margin-top: 2px;
  }

  .room-btn.active .room-name { color: var(--primary); }

  /* RADIO GROUP */
  .radio-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .radio-group label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #1E3A5F;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 6px;
    transition: background 0.15s;
  }

  .radio-group label:hover { background: #F0F6FC; }

  .radio-group input[type="radio"] {
    width: 16px;
    height: 16px;
    accent-color: var(--slider-fg);
    cursor: pointer;
  }

  .disclaimer {
    background: #E2EFFA;
    color: #0D405B;
    padding: 10px 15px;
    border-radius: 8px;
    font-size: 12px;
    margin-top: 15px;
  }

  .main-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 15px;
  }

  .energy-label-row {
    background: #E6F0F7;
    border: 2px solid #B3D2E8;
    border-radius: 10px;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 15px;
  }

  .label-pill {
    font-size: 24px;
    font-weight: 800;
    color: white;
    padding: 8px 28px;
    border-radius: 8px;
    min-width: 80px;
    text-align: center;
    transition: background 0.3s;
  }

  .badge {
    background: white;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #003153;
    border: 2px solid #98C1D9;
  }

  .badge.lmw { font-size: 15px; font-weight: 700; }

  .presets-label {
    font-size: 12px;
    color: var(--text-light);
    margin-bottom: 6px;
  }

  .presets {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 15px;
  }

  .preset-btn {
    background: white;
    color: #164863;
    border: 2px solid #B9D4E7;
    padding: 7px 14px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .preset-btn:hover { border-color: var(--slider-fg); background: #F0F8FF; }
  .preset-btn.active { background: var(--slider-fg); color: white; border-color: var(--slider-fg); }

  .price-box {
    background: #E8F0F9;
    border: 2px solid #B9D4E7;
    border-radius: 10px;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    flex-wrap: wrap;
  }

  .price-box .price-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    flex: 1;
    min-width: 120px;
  }

  .price-box input {
    width: 90px;
    padding: 8px;
    border: 2px solid #7AA9C4;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 700;
    color: #1F4E79;
    text-align: right;
    font-family: inherit;
    outline: none;
  }

  .price-box input:focus { border-color: var(--slider-fg); }

  .price-box select {
    padding: 8px;
    border: 2px solid #7AA9C4;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    color: #1F4E79;
    font-family: inherit;
    background: white;
    cursor: pointer;
    outline: none;
  }

  .price-box .unit { font-size: 13px; font-weight: 700; color: #2C5F7B; }

  .sliders-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 15px;
  }

  .slider-card {
    background: #F9FCFF;
    border: 2px solid #E2ECF5;
    border-radius: 8px;
    padding: 15px;
  }

  .slider-card .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .slider-card .slider-header .label {
    font-size: 13px;
    font-weight: 700;
    color: #164863;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .slider-card .slider-header .value {
    font-size: 13px;
    font-weight: 700;
    color: #2C7DA0;
  }

  .slider-card input[type="range"] {
    width: 100%;
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
    background: var(--slider-bg);
    border-radius: 3px;
    outline: none;
    cursor: pointer;
    margin: 8px 0 4px;
  }

  .slider-card input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--slider-fg);
    cursor: pointer;
    border: 3px solid white;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }

  .slider-card input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--slider-fg);
    cursor: pointer;
    border: 3px solid white;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }

  .slider-card .display-value {
    text-align: right;
    font-size: 16px;
    font-weight: 800;
    color: #0E4B6B;
  }

  .info-row {
    background: #EEF5FA;
    border-radius: 8px;
    padding: 10px 20px;
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text);
    margin-bottom: 15px;
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 20px;
  }

  .result-card {
    background: var(--result-bg);
    border: 2px solid var(--result-border);
    border-radius: 10px;
    padding: 18px 20px;
  }

  .result-card .result-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #3B5F7A;
    margin-bottom: 8px;
  }

  .result-card .result-value {
    display: flex;
    align-items: baseline;
    gap: 5px;
  }

  .result-card .result-value .num {
    font-size: 26px;
    font-weight: 800;
    color: #003249;
  }

  .result-card .result-value .unit {
    font-size: 13px;
    color: #2D618C;
    font-weight: 500;
  }

  .button-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 15px;
  }

  .btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    font-family: inherit;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-light); }

  .btn-success { background: var(--success); color: white; }
  .btn-success:hover { background: var(--success-hover); }

  .btn-outline {
    background: white;
    color: var(--primary);
    border: 1px solid #AAC3D4;
  }
  .btn-outline:hover { background: #F0F6FC; }

  .footnote {
    font-size: 12px;
    color: var(--text-light);
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(11, 43, 64, 0.5);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .modal-overlay.open { display: flex; }

  .modal {
    background: var(--bg);
    border-radius: 12px;
    max-width: 750px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .modal-header {
    background: var(--primary);
    padding: 20px;
    border-radius: 12px 12px 0 0;
  }

  .modal-header h2 { color: white; font-size: 20px; }
  .modal-header p { color: #CBD5E1; font-size: 12px; margin-top: 4px; }

  .modal-body { background: white; padding: 20px 25px; }

  .modal-section-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--primary);
    margin: 18px 0 8px;
  }

  .modal-section-title:first-child { margin-top: 0; }

  .modal-row {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom: 1px solid #E0E0E0;
    font-size: 13px;
  }

  .modal-row .label { color: #666; }
  .modal-row .value { font-weight: 700; color: var(--text); }

  .modal-footer {
    padding: 15px 20px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    background: var(--bg);
    border-radius: 0 0 12px 12px;
  }

  @media (max-width: 1000px) {
    .content { flex-direction: column; }
    .left-panel { width: 100%; min-width: unset; max-height: none; border-right: none; border-bottom: 1px solid var(--border); }
    .right-panel { max-height: none; }
  }

  @media (max-width: 600px) {
    body { padding: 8px; }
    .header { padding: 14px 16px 12px; }
    .left-panel, .right-panel { padding: 16px; }
    .sliders-grid, .results-grid { grid-template-columns: 1fr; }
    .header-info { gap: 14px; font-size: 12px; }
    .field-row { flex-direction: column; align-items: stretch; gap: 4px; }
    .field-row label { width: auto; }
    .energy-label-row { flex-direction: column; align-items: flex-start; }
    .button-row { flex-direction: column; }
    .btn { width: 100%; justify-content: center; }
    .header-brand .logo-img { width: 36px; height: 36px; }
  }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: #F1F5F9; }
  ::-webkit-scrollbar-thumb { background: #B0C4D4; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #8FA8BC; }
</style>
</head>
<body>

<div class="app-container">
  <!-- HEADER -->
  <header class="header">
    <div class="header-top">
      <div class="header-brand">
        <img src="logo.png" alt="LightingBuro Logo" class="logo-img">
        <div>
          <h1 id="appTitle">Lighting Bureau <span class="school-badge">School</span></h1>
          <p id="appSubtitle">Free lighting calculator for schools</p>
        </div>
      </div>
      <div class="lang-buttons" id="langButtons"></div>
    </div>
    <div class="header-info" id="headerInfo">
      <div class="header-info-item">👤 <span id="hProjectLabel">Project:</span> <span class="value" id="hProject">Janssens</span></div>
      <div class="header-info-item">📍 <span id="hAddressLabel">Address:</span> <span class="value empty" id="hAddress">—</span></div>
      <div class="header-info-item">🏫 <span id="hBuildingLabel">Space:</span> <span class="value" id="hBuilding">Classroom</span></div>
      <div class="header-info-item">🔆 <span id="hDimmableLabel">Dimmable:</span> <span class="value" id="hDimmable">—</span></div>
    </div>
  </header>

  <!-- CONTENT -->
  <div class="content">
    <!-- LEFT PANEL -->
    <aside class="left-panel">
      <!-- General info -->
      <div class="section-title">📝 <span id="secGeneralInfo">General information</span></div>
      <div class="info-block">
        <div class="field-row">
          <label id="lblProjectName">Name / project</label>
          <input type="text" id="projectName" value="Janssens" placeholder="Enter name">
        </div>
        <div class="field-row">
          <label id="lblAddress">Address / location</label>
          <input type="text" id="addressName" value="" placeholder="Enter address (optional)">
        </div>
        <div class="field-row">
          <label id="lblCountry">Country</label>
          <select id="countrySelect"></select>
        </div>
      </div>

      <!-- School rooms -->
      <div class="rooms-title">
        <span style="font-size:18px;">🏫</span>
        <h3 id="roomsHeader">School Rooms — Quick Select</h3>
        <span class="free-badge">FREE</span>
      </div>
      <div id="roomsContainer"></div>

      <!-- Dimmable -->
      <div class="section-title">🎚️ <span id="secDimmable">Dimmable</span></div>
      <div class="info-block">
        <div class="radio-group">
          <label><input type="radio" name="dimmable" value="yes" checked> <span id="dimYesLabel">Yes, dimmable</span></label>
          <label><input type="radio" name="dimmable" value="no"> <span id="dimNoLabel">No, fixed</span></label>
          <label><input type="radio" name="dimmable" value="smart"> <span id="dimSmartLabel">Smart control</span></label>
        </div>
      </div>

      <!-- Contact -->
      <div class="section-title">👤 <span id="secContact">Contact</span></div>
      <div class="info-block">
        <div class="field-row">
          <label id="lblContactPerson">Contact person</label>
          <input type="text" id="contactPerson" value="" placeholder="Enter name (optional)">
        </div>
        <div class="field-row">
          <label id="lblEmail">Email</label>
          <input type="email" id="contactEmail" value="" placeholder="Enter email (optional)">
        </div>
      </div>

      <div class="disclaimer" id="epbDisclaimer">🌿 Consumption only – EPB out of scope</div>
    </aside>

    <!-- RIGHT PANEL -->
    <main class="right-panel">
      <div class="main-title">🧮 <span id="mainTitle">Annual consumption &amp; costs</span></div>

      <div class="energy-label-row">
        <div class="label-pill" id="labelPill" style="background:#8BC34A;">A</div>
        <div class="badge" id="dimmableIcon">🔆 dimmable</div>
        <div class="badge lmw" id="lmwDisplay">150 lm/W</div>
        <div class="badge lmw" id="kelvinDisplay">5000 K</div>
      </div>

      <div class="presets-label" id="presetsLabel">Quick presets:</div>
      <div class="presets" id="presetsContainer"></div>

      <div class="price-box">
        <div class="price-title" id="priceTitle">💶 Energy price</div>
        <span class="unit">/kWh</span>
        <select id="currencySelect">
          <option value="€">€</option>
          <option value="$">$</option>
          <option value="£">£</option>
          <option value="SEK">SEK</option>
          <option value="CAD">CAD</option>
          <option value="AUD">AUD</option>
          <option value="JPY">JPY</option>
          <option value="CNY">CNY</option>
