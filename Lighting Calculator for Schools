// STATE
// ============================================================================
let currentLang = 'en';
let activePreset = 0;
let activeRoom = 'classroom';
let currentKelvin = 5000;
let currentLmw = 150;

const $ = (id) => document.getElementById(id);

// ============================================================================
// INIT
// ============================================================================
function init() {
  populateCountrySelect();
  buildLangButtons();
  buildRooms();
  buildPresets();
  bindEvents();
  setLanguage('en');
  applyRoom('classroom');
}

function populateCountrySelect() {
  const sel = $('countrySelect');
  sel.innerHTML = '';
  Object.keys(COUNTRIES).forEach(key => {
    const opt = document.createElement('option');
    opt.value = key;
    opt.textContent = COUNTRIES[key][2];
    sel.appendChild(opt);
  });
}

function buildLangButtons() {
  const container = $('langButtons');
  container.innerHTML = '';
  LANGUAGES.forEach(([code, label]) => {
    const btn = document.createElement('button');
    btn.className = 'lang-btn';
    btn.textContent = label;
    btn.dataset.lang = code;
    btn.addEventListener('click', () => setLanguage(code));
    container.appendChild(btn);
  });
}

function buildRooms() {
  const container = $('roomsContainer');
  container.innerHTML = '';
  SCHOOL_ROOMS.forEach(room => {
    const btn = document.createElement('button');
    btn.className = 'room-btn' + (room.id === activeRoom ? ' active' : '');
    btn.dataset.room = room.id;
    btn.innerHTML = `
      <span class="room-icon">${room.icon}</span>
      <span class="room-info">
        <span class="room-name" data-room-name="${room.id}">${room.name.en}</span>
        <span class="room-specs" data-room-specs="${room.id}">${room.specs.en}</span>
      </span>
    `;
    btn.addEventListener('click', () => applyRoom(room.id));
    container.appendChild(btn);
  });
}

function buildPresets() {
  const container = $('presetsContainer');
  container.innerHTML = '';
  PRESETS.forEach((p, i) => {
    const btn = document.createElement('button');
    btn.className = 'preset-btn' + (i === activePreset ? ' active' : '');
    btn.dataset.index = i;
    btn.addEventListener('click', () => setLumenWatt(p.lmw, p.kelvin, i));
    container.appendChild(btn);
  });
}

function applyRoom(roomId) {
  const room = SCHOOL_ROOMS.find(r => r.id === roomId);
  if (!room) return;
  activeRoom = roomId;

  document.querySelectorAll('.room-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.room === roomId);
  });

  $('numLuminaires').value = room.values.num;
  $('powerPerLuminaire').value = room.values.power;
  $('hoursPerDay').value = room.values.hours;
  $('daysPerWeek').value = room.values.days;

  const roomName = room.name[currentLang] || room.name.en;
  $('hBuilding').textContent = roomName.replace(/^[^\s]+\s/, '');

  onSliderChange();
}

function updateRoomLabels() {
  const t = TRANSLATIONS[currentLang];
  SCHOOL_ROOMS.forEach(room => {
    const nameEl = document.querySelector(`[data-room-name="${room.id}"]`);
    const specsEl = document.querySelector(`[data-room-specs="${room.id}"]`);
    if (nameEl && room.name[currentLang]) nameEl.textContent = room.name[currentLang];
    if (specsEl && room.specs[currentLang]) {
      specsEl.textContent = room.specs[currentLang];
    } else if (specsEl) {
      specsEl.textContent = room.specs.en;
    }
  });
  $('roomsHeader').textContent = t.rooms_header;
}

// ============================================================================
// EVENT BINDING
// ============================================================================
function bindEvents() {
  $('projectName').addEventListener('input', updateHeaderInfo);
  $('addressName').addEventListener('input', updateHeaderInfo);
  $('contactPerson').addEventListener('input', () => {});
  $('contactEmail').addEventListener('input', () => {});
  $('countrySelect').addEventListener('change', onCountryChange);

  document.querySelectorAll('input[name="dimmable"]').forEach(rb => {
    rb.addEventListener('change', updateHeaderInfo);
  });

  $('currencySelect').addEventListener('change', calculate);
  $('energyPrice').addEventListener('input', calculate);

  ['numLuminaires', 'powerPerLuminaire', 'hoursPerDay', 'daysPerWeek'].forEach(id => {
    $(id).addEventListener('input', onSliderChange);
  });

  $('btnUpdate').addEventListener('click', calculate);
  $('btnPdf').addEventListener('click', generatePdf);
  $('btnPreview').addEventListener('click', previewPdf);
  $('btnReset').addEventListener('click', resetDefault);

  $('btnCloseModal').addEventListener('click', () => $('previewModal').classList.remove('open'));
  $('previewModal').addEventListener('click', (e) => {
    if (e.target === $('previewModal')) $('previewModal').classList.remove('open');
  });
  $('btnDownloadModal').addEventListener('click', () => {
    $('previewModal').classList.remove('open');
    generatePdf();
  });
}

