  $('previewModal').classList.add('open');
}

// ============================================================================
// PDF GENERATION
// ============================================================================
function generatePdf() {
  const data = getReportData();
  const t = data.t;

  const printWindow = window.open('', '_blank');
  if (!printWindow) {
    alert('Please allow pop-ups to generate the PDF report.');
    return;
  }

  let html = `
    <!DOCTYPE html>
    <html>
    <head>
      <meta charset="UTF-8">
      <title>${data.appTitle} - Report</title>
      <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; margin: 30px; color: #0B2B40; }
        h1 { color: #0B2B40; font-size: 26px; margin-bottom: 5px; }
        .subtitle { color: #666; font-size: 13px; margin-bottom: 25px; }
        h2 { color: #0B2B40; font-size: 16px; margin-top: 25px; margin-bottom: 10px; border-bottom: 2px solid #0B2B40; padding-bottom: 5px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        td { padding: 6px 10px; border-bottom: 1px solid #E0E0E0; font-size: 13px; }
        td:first-child { color: #666; width: 40%; }
        td:last-child { font-weight: 600; }
        .disclaimer { margin-top: 30px; font-size: 11px; color: #999; font-style: italic; }
        @media print { body { margin: 15mm; } }
      </style>
    </head>
    <body>
      <h1>${data.appTitle} — School Edition</h1>
      <div class="subtitle">${t.generated_on}: ${data.generatedOn}</div>
  `;

  const addSection = (title) => { html += `<h2>${title}</h2><table>`; };
  const addRow = (label, value) => { html += `<tr><td>${label}</td><td>${value}</td></tr>`; };
  const closeTable = () => { html += '</table>'; };

  addSection('📋 ' + t.project_details);
  addRow(t.pdf_project, data.project);
  addRow(t.pdf_address, data.address);
  if (data.contact) addRow(t.pdf_contact, data.contact);
  addRow(t.pdf_country, data.country);
  addRow(t.pdf_building_type, data.buildingType);
  addRow(t.pdf_dimmable, data.dimmable);
  closeTable();

  addSection('💡 ' + t.lighting_installation);
  addRow(t.pdf_luminaires, data.numLuminaires + ' ' + t.pieces);
  addRow(t.pdf_power, data.power + ' W');
  addRow(t.pdf_efficiency, data.lmw);
  addRow(t.pdf_color_temp, data.kelvin);
  addRow(t.pdf_label, data.energyLabel);
  closeTable();

  addSection('⏱️ ' + t.usage_pattern);
  addRow(t.pdf_hours, data.hours + ' h/day, ' + data.days + ' days/week, 52 weeks/year');
  closeTable();

  addSection('📊 ' + t.annual_results);
  addRow(t.pdf_total_power, data.totalPower + ' kW');
  addRow(t.pdf_consumption, data.consumption + ' kWh');
  addRow(t.pdf_cost, data.cost + ' ' + data.currency);
  addRow(t.pdf_co2, data.co2 + ' kg');
  addRow(t.pdf_price, data.price + ' ' + data.currency + '/kWh');
  closeTable();

  html += `<div class="disclaimer">${t.pdf_disclaimer}</div>`;
  html += '</body></html>';

  printWindow.document.write(html);
  printWindow.document.close();

  setTimeout(() => { printWindow.print(); }, 500);
}

